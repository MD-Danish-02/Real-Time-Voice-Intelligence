# ===== Core =====
ENV=development                      # development | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001
API_HOST_PORT=8001
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg2://voxai:voxai@postgres:5432/voxai
ASYNC_DATABASE_URL=postgresql+asyncpg://voxai:voxai@postgres:5432/voxai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Secrets (generate real values; never commit) =====
JWT_SECRET=CHANGE_ME_DEV_ONLY                       # openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_DEV_ONLY!!     # openssl rand -hex 32
ALLOW_DEMO_SEED=true                                # MUST be false in production
AUTH_REFRESH_COOKIE_NAME=voxai_refresh
AUTH_REFRESH_COOKIE_SECURE=false                    # true behind HTTPS in production
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=

# ===== Password reset email =====
# Without SMTP configured, development reset links are printed in backend logs only.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# ===== Provider modes: mock (local, no credentials) | live values per provider =====
# Production refuses to start if any of these is "mock".
CRM_PROVIDER_MODE=mock
TELEPHONY_PROVIDER_MODE=mock        # mock | exotel | plivo | generic_sip
CALENDAR_PROVIDER_MODE=mock         # mock | google
WHATSAPP_PROVIDER_MODE=mock         # mock | meta_cloud_api
STT_PROVIDER_MODE=mock              # mock | faster_whisper
LLM_PROVIDER_MODE=mock              # mock | groq
TTS_PROVIDER_MODE=mock              # mock | chatterbox
KNOWLEDGE_EMBEDDING_MODE=local      # local | sentence_transformers

# ===== LLM / STT / TTS =====
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FASTER_WHISPER_MODEL=base
STT_LANGUAGE=auto                       # auto | hi | en
TTS_PROVIDER_NAME=chatterbox            # chatterbox | indicf5 | mock
TTS_API_KEY=
CHATTERBOX_BASE_URL=                    # empty for in-process engine, or http://tts:8880
CHATTERBOX_VOICE_ID=riya                # riya | default
CHATTERBOX_DEVICE=cpu                   # cpu | cuda
INDICF5_BASE_URL=

# ===== Asterisk / ARI / RTP =====
ARI_BASE_URL=http://asterisk:8088/ari
ARI_USERNAME=voxai
ARI_PASSWORD=CHANGE_ME
ARI_APP_NAME=voxai_voice_app
VOICE_MEDIA_HOST=backend
VOICE_MEDIA_HOST_EXTERNAL=          # Public IP/hostname for bare-metal Asterisk to reach backend (e.g., 161.118.180.20)
VOICE_RTP_PORT_START=10000
VOICE_RTP_PORT_END=10020

# ===== Telephony =====
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
SIP_PUBLIC_HOST=
GENERIC_SIP_HOST=
GENERIC_SIP_USERNAME=
GENERIC_SIP_PASSWORD=

# ===== CRM OAuth apps =====
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8001/api/v1/crm/oauth/hubspot/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8001/api/v1/crm/oauth/salesforce/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8001/api/v1/crm/oauth/zoho/callback
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://localhost:8001/api/v1/crm/oauth/pipedrive/callback

# ===== Google (Calendar + Sheets) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/callback
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8001/api/v1/crm/oauth/google_sheets/callback

# ===== WhatsApp (Meta Cloud API - paid per conversation by Meta) =====
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=

# ===== Object storage (S3-compatible) =====
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=voxai-media
S3_REGION=us-east-1

# ===== Rate limits =====
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# ===== Frontend (apps/web) =====
NEXT_PUBLIC_API_URL=http://localhost:8001
